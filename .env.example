# Controller v1.4.0 Configuration

# Application
APP_NAME="OpenClaw Controller v1.4.0"
APP_VERSION="1.4.0"
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=1

# Session
SESSION_STORE_TYPE=file
SESSION_TTL_SECONDS=86400
SESSION_FILE_PATH=./sessions
# SESSION_REDIS_URL=redis://localhost:6379/0

# Identity
IDENTITY_DIR=./identity
IDENTITY_CACHE_FOREVER=true
IDENTITY_VERIFY_HASH=true
IDENTITY_AUTO_INJECT=true

# Routing and context
SAFE_ROUTING_ENABLED=true
CONTEXT_WINDOW_CHECK_ENABLED=true
CONTEXT_WINDOW_THRESHOLD=0.9
DEFAULT_PROVIDER=openai
FALLBACK_PROVIDERS=["anthropic", "openai", "ollama"]
ROUTING_MODE=balanced
ROUTE_FALLBACK_MAX_HOPS=3
ROUTE_STICKINESS_ENABLED=true
CONTEXT_TRUNCATION_STRATEGY=middle
TOKEN_ESTIMATION_CHARS_PER_TOKEN=4
TOKEN_ESTIMATION_SAFETY_MARGIN=1.15

# Optional route registry JSON
# ROUTE_REGISTRY_PATH=./config/routes.json

# Validation
VALIDATION_PIPELINE_ENABLED=true
VALIDATION_CACHE_TTL_SECONDS=300
VALIDATION_PROBE_TIMEOUT_SECONDS=6.0

# Health
HEALTH_ENABLED=true
HEALTH_CACHE_TTL_SECONDS=30
HEALTH_PROBE_TIMEOUT_SECONDS=5.0
HEALTH_PROBE_RETRIES=1

# Provider: OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_PREMIUM=gpt-4-turbo
OPENAI_MODEL_STANDARD=gpt-4
OPENAI_MODEL_BASIC=gpt-3.5-turbo

# Provider: Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_PREMIUM=claude-3-opus-20240229
ANTHROPIC_MODEL_STANDARD=claude-3-sonnet-20240229
ANTHROPIC_MODEL_BASIC=claude-3-haiku-20240307

# Provider: Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VALIDATION_BASE_URL=http://localhost:11434
OLLAMA_HEALTH_ENDPOINT=/api/tags
OLLAMA_MODEL=gemma4-e4b-q4-local

# Timeout profiles
TIMEOUT_PROFILE_DEFAULT_SECONDS=60.0
TIMEOUT_PROFILE_CLOUD_DEFAULT_SECONDS=60.0
TIMEOUT_PROFILE_LOCAL_DEFAULT_SECONDS=120.0

# Features
FEATURE_SESSION_PERSISTENCE=true
FEATURE_IDENTITY_CACHING=true
FEATURE_CONTEXT_PRESERVATION=true
FEATURE_SAFE_ROUTING=true
FEATURE_PROVIDER_PINNING=true
FEATURE_CONTEXT_AWARE_FALLBACK=true
FEATURE_VALIDATION_PIPELINE=true
FEATURE_ROUTING_LOGGING=true
FEATURE_METRICS_COLLECTION=true
FEATURE_SESSION_TRACING=true

# Compatibility
V120_COMPATIBILITY_MODE=false
STRICT_MODE=false

# Observability
ROUTING_LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true

# Security
API_KEY_REQUIRED=false
API_KEY=
ALLOWED_ORIGINS=["*"]

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
