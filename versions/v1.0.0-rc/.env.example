# Controller 1.0.0 RC - Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Controller API Key (required, minimum 16 characters)
# This is used to authenticate requests to the Controller API
CONTROLLER_API_KEY=your-secure-api-key-here-min16chars

# =============================================================================
# PROVIDER API KEYS (at least one recommended)
# =============================================================================

# OpenAI API Key (optional but recommended)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (optional)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Server bind host (default: 0.0.0.0)
CONTROLLER_HOST=0.0.0.0

# Server port (default: 8080)
CONTROLLER_PORT=8080

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Log format: json or text (default: json)
LOG_FORMAT=json

# =============================================================================
# PROVIDER SETTINGS
# =============================================================================

# Default provider when not specified (default: openai)
DEFAULT_PROVIDER=openai

# Fallback provider chain (comma-separated, default: openai,anthropic)
FALLBACK_PROVIDERS=openai,anthropic

# OpenAI settings
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic settings
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307
ANTHROPIC_VERSION=2023-06-01

# =============================================================================
# INTELLIGENCE SETTINGS
# =============================================================================

# Enable PII detection (default: true)
ENABLE_PII_DETECTION=true

# Enable jailbreak/prompt injection detection (default: true)
ENABLE_JAILBREAK_DETECTION=true

# High confidence threshold for premium tier (default: 0.8)
CONFIDENCE_THRESHOLD_HIGH=0.8

# Medium confidence threshold for standard tier (default: 0.5)
CONFIDENCE_THRESHOLD_MEDIUM=0.5

# Safety risk threshold for blocking (default: 0.7)
SAFETY_RISK_THRESHOLD=0.7

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# Requests per minute per client (default: 60)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================

# Enable circuit breaker (default: true)
CIRCUIT_BREAKER_ENABLED=true

# Consecutive failures before opening circuit (default: 5)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds to wait before attempting recovery (default: 30)
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# =============================================================================
# CACHE SETTINGS (optional, in-memory only in RC)
# =============================================================================

# Enable response caching (default: false)
CACHE_ENABLED=false

# Cache TTL in seconds (default: 300)
CACHE_TTL_SECONDS=300

# Redis URL for distributed caching (optional)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# METRICS (optional, not implemented in RC)
# =============================================================================

# Enable Prometheus metrics (default: false)
METRICS_ENABLED=false

# Metrics server port (default: 9090)
METRICS_PORT=9090

# =============================================================================
# TRACING (optional, not implemented in RC)
# =============================================================================

# Enable OpenTelemetry tracing (default: false)
TRACING_ENABLED=false

# Jaeger endpoint for tracing (optional)
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# =============================================================================
# RUNTIME PATHS (usually don't need to change)
# =============================================================================

RUNTIME_DIR=./runtime
LOGS_DIR=./runtime/logs
CACHE_DIR=./runtime/cache
PID_FILE=./runtime/controller.pid
