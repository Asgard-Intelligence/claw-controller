# Controller v1.3.0 Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_NAME="OpenClaw Controller v1.3.0"
APP_VERSION="1.3.0"
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=1

# ============================================
# Session Management (CRITICAL for v1.3.0)
# ============================================
# Options: file, redis, memory
SESSION_STORE_TYPE=file
SESSION_TTL_SECONDS=86400

# For file store
SESSION_FILE_PATH=./sessions

# For Redis store (uncomment to use Redis)
# SESSION_REDIS_URL=redis://localhost:6379/0

# ============================================
# Identity Management (CRITICAL for v1.3.0)
# ============================================
IDENTITY_DIR=./identity
IDENTITY_CACHE_FOREVER=true
IDENTITY_VERIFY_HASH=true
IDENTITY_AUTO_INJECT=true

# ============================================
# Context Preservation (CRITICAL for v1.3.0)
# ============================================
CONTEXT_PRESERVATION_ENABLED=true
CONTEXT_TRANSFER_TIMEOUT_SECONDS=30
# Options: middle, oldest, summarize
CONTEXT_TRUNCATION_STRATEGY=middle

# ============================================
# Safe Routing (CRITICAL for v1.3.0)
# ============================================
SAFE_ROUTING_ENABLED=true
CONTEXT_WINDOW_CHECK_ENABLED=true
# Route to larger model when context reaches 90% of capacity
CONTEXT_WINDOW_THRESHOLD=0.9
DEFAULT_PROVIDER=openai
FALLBACK_PROVIDERS=["anthropic", "openai"]

# ============================================
# Provider Configuration - OpenAI
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_PREMIUM=gpt-4-turbo
OPENAI_MODEL_STANDARD=gpt-4
OPENAI_MODEL_BASIC=gpt-3.5-turbo

# ============================================
# Provider Configuration - Anthropic
# ============================================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_PREMIUM=claude-3-opus-20240229
ANTHROPIC_MODEL_STANDARD=claude-3-sonnet-20240229
ANTHROPIC_MODEL_BASIC=claude-3-haiku-20240307

# ============================================
# Provider Configuration - Ollama (Local)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4-e4b-q4-local

# ============================================
# Validation Settings
# ============================================
VALIDATION_PIPELINE_ENABLED=true
# Options: strict, warn, off
INVARIANT_CHECKING=warn
REQUIRE_SYSTEM_PROMPT=true
REQUIRE_IDENTITY_IN_RESPONSES=true

# ============================================
# Feature Flags (Enable/Disable Features)
# ============================================
FEATURE_SESSION_PERSISTENCE=true
FEATURE_IDENTITY_CACHING=true
FEATURE_CONTEXT_PRESERVATION=true
FEATURE_SAFE_ROUTING=true
FEATURE_PROVIDER_PINNING=true
FEATURE_CONTEXT_AWARE_FALLBACK=true
FEATURE_VALIDATION_PIPELINE=true
FEATURE_ROUTING_LOGGING=true
FEATURE_METRICS_COLLECTION=true
FEATURE_SESSION_TRACING=true

# ============================================
# Migration Helpers
# ============================================
# Enable v1.2.0 compatibility mode during migration
V120_COMPATIBILITY_MODE=false
# Fail on any invariant violation
STRICT_MODE=false

# ============================================
# Observability
# ============================================
ROUTING_LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true

# ============================================
# Security
# ============================================
API_KEY_REQUIRED=false
API_KEY=your-secure-api-key-here
ALLOWED_ORIGINS=["*"]

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
