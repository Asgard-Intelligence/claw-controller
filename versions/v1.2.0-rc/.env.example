# Controller 1.2.0 RC - Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Controller API Key (required, minimum 16 characters)
# This authenticates OpenClaw (or any client) to the external controller.
CONTROLLER_API_KEY=your-secure-api-key-here-min16chars

# =============================================================================
# PROVIDER API KEYS (configure at least one live provider)
# =============================================================================

# OpenAI-compatible backend API key.
# For DGX/Ollama/OpenAI-compatible gateways this may be a local or dummy key,
# depending on your upstream gateway requirements.
OPENAI_API_KEY=sk-your-openai-compatible-key-here

# Anthropic API key (optional).
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# SERVER SETTINGS
# =============================================================================

CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8080

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# PROVIDER SETTINGS
# =============================================================================

# Default provider used for direct non-namespaced model ids.
DEFAULT_PROVIDER=openai

# Fallback chain. Accepts either comma-separated text or JSON array syntax.
# Examples:
#   FALLBACK_PROVIDERS=openai,anthropic
#   FALLBACK_PROVIDERS=["openai","anthropic"]
FALLBACK_PROVIDERS=openai,anthropic

# OpenAI-compatible backend settings
# Leave OPENAI_DEFAULT_MODEL empty unless you want to pin a model id that is actually exposed by /v1/models on your backend.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=

# Optional tier overrides used by controller intelligence mode.
# These are especially useful when the backend is a DGX/Ollama/OpenAI-compatible stack.
# Example local models:
# OPENAI_MODEL_PREMIUM=gemma4-31b-q4-local:latest
# OPENAI_MODEL_STANDARD=gemma4-e4b-q4-local:latest
# OPENAI_MODEL_BASIC=gemma4-e4b-q4-local:latest
OPENAI_MODEL_PREMIUM=
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_BASIC=

# Anthropic settings
# Leave ANTHROPIC_DEFAULT_MODEL empty unless you want to pin a discovered backend model id.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=
ANTHROPIC_MODEL_PREMIUM=
ANTHROPIC_MODEL_STANDARD=
ANTHROPIC_MODEL_BASIC=
ANTHROPIC_VERSION=2023-06-01

# Safety switches for backend-aware model discovery.
# Keep these enabled in production so the controller routes only to real backend models.
ROUTING_REQUIRE_DISCOVERED_MODELS=true
MODEL_DISCOVERY_STRICT=false
MODEL_DISCOVERY_REFRESH_SECONDS=300

# =============================================================================
# INTELLIGENCE SETTINGS
# =============================================================================

ENABLE_PII_DETECTION=true
ENABLE_JAILBREAK_DETECTION=true
CONFIDENCE_THRESHOLD_HIGH=0.8
CONFIDENCE_THRESHOLD_MEDIUM=0.5
SAFETY_RISK_THRESHOLD=0.7

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================

CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# =============================================================================
# CACHE SETTINGS (optional)
# =============================================================================

CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# METRICS / TRACING (optional)
# =============================================================================

METRICS_ENABLED=false
METRICS_PORT=9090
TRACING_ENABLED=false
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# =============================================================================
# RUNTIME PATHS
# =============================================================================

RUNTIME_DIR=./runtime
LOGS_DIR=./runtime/logs
CACHE_DIR=./runtime/cache
PID_FILE=./runtime/controller.pid
